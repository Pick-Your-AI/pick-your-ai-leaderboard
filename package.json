{
  "name": "@pick-your-ai/leaderboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/contracts",
    "packages/github",
    "packages/metrics",
    "packages/ingestion",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "node scripts/format-source.mjs --write",
    "format:check": "node scripts/format-source.mjs --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretypecheck": "npm run format:check",
    "test": "node --test \"packages/{contracts,github,metrics,ingestion}/test/**/*.test.{js,mjs,ts}\" \"apps/*/test/**/*.test.{js,mjs,ts}\" \"infra/{db,recovery,observability,retention}/test/**/*.test.mjs\"",
    "dev:web": "npm run dev --workspace @pick-your-ai/web",
    "dev:service": "npm run dev --workspace @pick-your-ai/service",
    "dev:worker": "npm run dev --workspace @pick-your-ai/worker",
    "db:migrate": "node --env-file-if-exists=.env infra/db/migrate.mjs",
    "db:rollback": "node --env-file-if-exists=.env infra/db/rollback.mjs",
    "db:seed:synthetic": "node --env-file-if-exists=.env infra/db/seed-synthetic.mjs",
    "db:validate": "node --env-file-if-exists=.env infra/db/validate.mjs",
    "test:browser": "tsc --noEmit -p apps/web/tsconfig.browser.json && playwright test --config apps/web/playwright.config.ts",
    "test:wall-soak": "node --test apps/web/test/wall-soak-assertions.test.mjs apps/web/test/soak-monitor.test.mjs apps/web/test/soak-receipt.test.mjs apps/web/test/wall-soak-midnight.test.mjs apps/web/test/wall-soak-intent.test.mjs apps/web/test/wall-soak-chronology.test.mjs apps/web/test/wall-soak-failures.test.mjs apps/web/test/wall-soak-endpoint.test.mjs && tsc --noEmit -p apps/web/tsconfig.soak.json && playwright test --config apps/web/playwright.soak.config.ts",
    "pretest:wall-soak": "npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "pg": "8.23.1",
    "prettier": "3.9.10"
  }
}
