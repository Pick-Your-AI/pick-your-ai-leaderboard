{
  "name": "@pick-your-ai/service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./live-client": {
      "types": "./dist/live-client.d.ts",
      "default": "./dist/live-client.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@pick-your-ai/contracts": "0.1.0",
    "@pick-your-ai/metrics": "0.1.0",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
