{
  "worktree": {
    "setup": [
      "npm exec --yes --package=npm@12.2.0 -- npm ci"
    ],
    "teardown": "echo \"Setup starts no persistent services; Paseo handles worktree removal.\""
  },
  "scripts": {
    "diff-check": {
      "command": "git diff --check"
    },
    "test": {
      "command": "npm exec --yes --package=npm@12.2.0 -- npm run test"
    },
    "build": {
      "command": "npm exec --yes --package=npm@12.2.0 -- npm run build"
    },
    "typecheck": {
      "command": "npm exec --yes --package=npm@12.2.0 -- npm run typecheck"
    },
    "format-check": {
      "command": "npm exec --yes --package=npm@12.2.0 -- npm run format:check"
    }
  }
}
